# Title Segmentation Statistics
#
# generating_program segstats.py
# cmdline segstats.py --segfile mri/aparc.DKTatlas+aseg.deep.mgz --normfile mri/orig_nu.mgz --segstatsfile stats/aseg+DKT.VINN.stats
# sysname  Linux
# hostname fixture-host
# user     nonroot
# anatomy_type volume
#
# SUBJECTS_DIR /output
# subjectname fixture-fastsurfer
# HAND-WRITTEN TEST FIXTURE in the style of FastSurfer's aseg+DKT stats: the
# cortex is reported per DKT region (ctx-lh-*, ctx-rh-*), not as one
# structure. Every number is invented. Not a real subject.
