# Copy to .env and adjust. All of these have sane defaults for local dev
# except SECRET_KEY, which you should always override outside dev.

# --- App metadata ---
# Rarely overridden; listed so this file covers every field Settings reads.
APP_NAME=FADE API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

ENVIRONMENT=development
DEBUG=true

# SQLite by default (zero external dependencies). For Postgres:
# DATABASE_URL=postgresql+asyncpg://fade:fade@localhost:5432/fade
DATABASE_URL=sqlite+aiosqlite:///./fade.db
DATABASE_ECHO=false

# Generate a real one for anything beyond local dev: `openssl rand -hex 32`
SECRET_KEY=dev-only-insecure-secret-change-me-via-SECRET_KEY-env-var
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_MINUTES=10080

CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

RATE_LIMIT_DEFAULT=120/minute

UNCERTAINTY_REVIEW_THRESHOLD=45.0

# Calibration file: every fuzzy-set breakpoint, unit and output set. A bare
# name is looked up in app/calibration/; a path is used as given. The
# default is fitted to the synthetic phantom, so real data comes back
# indeterminate until a file with "domain": "real" is supplied here.
# See docs/REAL_DATA_RUNBOOK.md.
CALIBRATION_FILE=phantom.v0.json

# --- Biomarkers derived from FreeSurfer / FastSurfer stats ---
# Regions whose ThickAvg is averaged (both hemispheres) into cortical_thickness.
CORTICAL_THICKNESS_REGIONS=["entorhinal","parahippocampal","superiortemporal","middletemporal","inferiortemporal"]
# unweighted = plain mean of ThickAvg; surface_area = weighted by SurfArea.
CORTICAL_THICKNESS_WEIGHTING=unweighted
# Plausibility bounds as [min, max]. Outside them a scan is QC-flagged and
# returned indeterminate; it is not rejected.
PLAUSIBILITY_ICV_MM3=[1000000,2200000]
PLAUSIBILITY_HIPPOCAMPUS_TOTAL_MM3=[2000,12000]
PLAUSIBILITY_THICKNESS_MM=[1.0,5.0]
# Largest accepted stats file (aseg.stats / aparc.stats), in KB.
MAX_STATS_UPLOAD_KB=1024

MAX_UPLOAD_MB=64
UPLOAD_DIR=./data/uploads
# Gross sanity limits on an uploaded NIfTI: voxel size [min, max] in mm, and
# the largest volume accepted, in voxels.
NIFTI_VOXEL_MM_RANGE=[0.1,10.0]
NIFTI_MAX_VOXELS=134217728

# --- DICOM uploads (POST .../scans/upload-dicom) ---
# Reject a DICOM whose identifying header tags are not blank. Leave this on.
REQUIRE_ANONYMISED_DICOM=true
DICOM_IDENTIFYING_TAGS=["PatientName","PatientID","PatientBirthDate","OtherPatientIDs","InstitutionName","ReferringPhysicianName","AccessionNumber","StudyDate"]
DICOM_ZIP_MAX_FILES=5000
DICOM_ZIP_MAX_UNPACKED_MB=2048
DICOM_CONVERSION_TIMEOUT_SECONDS=600

# --- Volumetry provider: what happens to an uploaded scan file ---
#   external           store it, wait for FreeSurfer stats to be attached (default)
#   fastsurfer_docker  run FastSurfer in Docker as a background job
#   inhouse            phantom-tuned volumetry; PHANTOM patients only
VOLUMETRY_PROVIDER=external

# Used only by fastsurfer_docker.
FASTSURFER_IMAGE=deepmi/fastsurfer:latest
FASTSURFER_USE_GPU=false
FASTSURFER_TIMEOUT_SECONDS=10800
FASTSURFER_EXTRA_ARGS=[]
# Host path of the FreeSurfer licence file; mounted read-only when set.
# FS_LICENSE_PATH=C:/freesurfer/license.txt
# "uid:gid" for the container. Default: this process's ids (1000:1000 on Windows).
# FASTSURFER_DOCKER_USER=1000:1000
# Where FastSurfer writes. Default: <UPLOAD_DIR>/fastsurfer
# FASTSURFER_OUTPUT_DIR=./data/uploads/fastsurfer
