# Used by docker-compose.yml at the repo root. Copy to .env before running
# `docker compose up --build`.

# Required — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The browser-facing API URL, baked into the frontend's static build at
# build time. Must match the `api` service's published host port below,
# not an internal docker-network hostname — the browser calls this
# directly, it never goes container-to-container.
VITE_API_BASE_URL=http://localhost:8000

# How the API authenticates requests.
#   production   every request needs a bearer token (AUTH_MODE=required).
#                The dashboard has no login screen yet, so it will show
#                401 errors until one is built.
#   development  a request with no token acts as one shared demo clinician
#                (AUTH_MODE=demo). For demos on synthetic data only.
# Defaults to production when unset.
ENVIRONMENT=production
# Normally left blank so it follows ENVIRONMENT. AUTH_MODE=demo together
# with ENVIRONMENT=production stops the API from starting.
AUTH_MODE=
