# Used by docker-compose.yml at the repo root. Copy to .env before running
# `docker compose up --build`.

# Required — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The browser-facing API URL, baked into the frontend's static build at
# build time. Must match the `api` service's published host port below,
# not an internal docker-network hostname — the browser calls this
# directly, it never goes container-to-container.
VITE_API_BASE_URL=http://localhost:8000
